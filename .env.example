# Configuracion del despliegue del equipo.
#
#   cp .env.example .env     y edita los valores
#
# Este archivo se lee automaticamente al usar `docker compose -f
# docker-compose.equipo.yaml`. El `.env` de verdad NO se sube al repositorio
# (esta en .gitignore): contiene contrasenas.


# ---------------------------------------------------------------------------
# Como llegan tus companeros al servidor
# ---------------------------------------------------------------------------

# Nombre por el que se entra desde el navegador. Con Tailscale es el nombre de
# la maquina que hospeda el servidor; lo ves con `tailscale status`.
# Ejemplo: mi-pc.tigre-rana.ts.net
LOGIGATOR_HOST=localhost

# Direccion en la que escucha el servidor.
#
#   127.0.0.1   solo esta maquina (valor por defecto, el mas prudente)
#   100.x.y.z   la IP de Tailscale de esta maquina: la ven los cinco y nadie mas
#   0.0.0.0     todas las interfaces, incluida tu red local y, si el equipo esta
#               expuesto, internet. No lo uses salvo que sepas lo que haces.
#
# La IP de Tailscale la da `tailscale ip -4`.
LOGIGATOR_BIND=127.0.0.1

# Puertos del anfitrion. Cambialos si el 80 o el 443 ya estan ocupados.
LOGIGATOR_HTTP_PORT=80
LOGIGATOR_HTTPS_PORT=443


# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Estas contrasenas tienen que coincidir con las de
# logigator-backend/config/ormconfig.json. No se salen de la red interna de
# Docker, pero ponles algo propio igualmente.

MYSQL_ROOT_PASSWORD=cambiame-root
MYSQL_DATABASE=logigator
MYSQL_USER=logigator
MYSQL_PASSWORD=cambiame-logigator


# ---------------------------------------------------------------------------
# Las cinco personas autorizadas
# ---------------------------------------------------------------------------
# Formato: usuario:correo:contrasena, separadas por comas. La contrasena debe
# tener 8 caracteres como minimo.
#
# Las cuentas se crean con:
#   docker compose -f docker-compose.equipo.yaml exec app node tools/seed-team.js
#
# El correo no tiene que existir de verdad: no hay servidor de correo y las
# cuentas nacen verificadas. Sirve para iniciar sesion.
#
# Una vez creadas las cuentas puedes borrar esta linea del .env si prefieres no
# dejar las contrasenas escritas; el script solo hace falta para darlas de alta
# o para cambiarlas con --update-password.

LOGIGATOR_TEAM=ana:ana@equipo.local:cambiame123,luis:luis@equipo.local:cambiame123


# ---------------------------------------------------------------------------
# Servidor de sincronizacion
# ---------------------------------------------------------------------------
# Deja esto en true. Con `false` cualquiera que alcance el puerto puede entrar a
# cualquier documento sin iniciar sesion; solo tiene sentido para depurar.
SYNC_REQUIRE_AUTH=true
